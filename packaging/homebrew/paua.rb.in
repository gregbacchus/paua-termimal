# Template for the Homebrew formula. The release workflow fills in the @...@ values and commits
# the result to the tap repository as Formula/paua.rb.
class Paua < Formula
  desc "Colourful terminal for GNOME"
  homepage "https://github.com/@REPO@"
  version "@VERSION@"

  depends_on :linux

  on_intel do
    url "https://github.com/@REPO@/releases/download/v@VERSION@/paua-@VERSION@-linux-x86_64.tar.gz"
    sha256 "@SHA_X86_64@"
  end

  on_arm do
    url "https://github.com/@REPO@/releases/download/v@VERSION@/paua-@VERSION@-linux-aarch64.tar.gz"
    sha256 "@SHA_AARCH64@"
  end

  def install
    bin.install "paua"
  end

  def caveats
    <<~EOS
      Paua uses the system GTK 4 and libadwaita (Ubuntu 24.04 or newer, or a similar GNOME distro):
        sudo apt install libgtk-4-1 libadwaita-1-0

      To add it to the GNOME overview with its icon, run once (and again after moving brew):
        paua install
    EOS
  end

  test do
    assert_match "colourful terminal", shell_output("#{bin}/paua --help")
  end
end
